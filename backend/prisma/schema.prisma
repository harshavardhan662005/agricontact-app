generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}
datasource db {
  provider = "postgresql"
}

model User {
  id              String     @id @default(uuid())
  name            String
  phone           String     @unique
  password        String
  role            String     @default("FARMER")
  latitude        Float?
  longitude       Float?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  listings        Listing[]
  farmerContracts Contract[] @relation("FarmerContracts")
  buyerContracts  Contract[] @relation("BuyerContracts")
}

model Listing {
  id          String     @id @default(uuid())
  title       String
  cropType    String
  quantityKg  Float
  pricePerKg  Float
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  contracts   Contract[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Contract {
  id               String   @id @default(uuid())
  listingId        String
  listing          Listing  @relation(fields: [listingId], references: [id])
  buyerId          String
  buyer            User     @relation("BuyerContracts", fields: [buyerId], references: [id])
  farmerId         String
  farmer           User     @relation("FarmerContracts", fields: [farmerId], references: [id])
  agreedQuantityKg Float
  agreedPricePerKg Float
  deliveryDate     DateTime
  status           String   @default("PROPOSED")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}